{
  // Code that runs in Node: unit tests (src/**/*.test.ts), e2e/,
  // build/ plugins and the configs
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "lib": ["es2023", "dom"],
    "types": ["node"],
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo"
  },
  "include": ["e2e", "build", "scripts", "src/**/*.test.ts", "*.ts"],
  "exclude": []
}
